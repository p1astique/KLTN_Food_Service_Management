<!doctype html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] · Bếp Nhà</title>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
@if (User.Identity?.IsAuthenticated == true)
{
    <div class="app-shell">
        <aside class="sidebar">
            <a class="brand" asp-controller="Dashboard" asp-action="Index"><span class="brand-icon">B</span><span>Bếp Nhà<small>PORTAL GIAN HÀNG</small></span></a>
            <div class="side-label">QUẢN LÝ</div>
            <nav class="side-nav">
                <a asp-controller="Dashboard" asp-action="Index" class="@(ViewContext.RouteData.Values["controller"]?.ToString() == "Dashboard" ? "active" : "")"><span>⌂</span>Tổng quan</a>
                <a asp-controller="Store" asp-action="Profile" class="@(ViewContext.RouteData.Values["controller"]?.ToString() == "Store" ? "active" : "")"><span>▣</span>Thông tin gian hàng</a>
                <a asp-controller="Catalog" asp-action="Index" class="@(ViewContext.RouteData.Values["controller"]?.ToString() == "Catalog" ? "active" : "")"><span>▦</span>Danh mục & món ăn</a>
                <a asp-controller="Orders" asp-action="Index" class="@(ViewContext.RouteData.Values["controller"]?.ToString() == "Orders" ? "active" : "")"><span>▤</span>Đơn hàng</a>
            </nav>
            <div class="sidebar-bottom">
                <div class="user-mini"><div class="avatar">@(User.Identity?.Name?.FirstOrDefault() ?? 'G')</div><div><b>@User.Identity?.Name</b><small>Đối tác gian hàng</small></div></div>
                <form asp-controller="Account" asp-action="Logout" method="post"><button class="logout-link" type="submit">↪ Đăng xuất</button></form>
            </div>
        </aside>
        <main class="main-area">
            <header class="topbar"><div><span class="muted">Không gian quản lý</span><span class="breadcrumb-sep">/</span><b>@ViewData["Title"]</b></div><span class="today">● Đang hoạt động</span></header>
            <section class="page-content">
                @if (TempData["Success"] is string success) { <div class="alert success">✓ @success</div> }
                @if (TempData["Error"] is string error) { <div class="alert error">@error</div> }
                @RenderBody()
            </section>
        </main>
    </div>
}
else
{
    <main class="auth-wrap">@RenderBody()</main>
}
<script src="~/js/site.js" asp-append-version="true"></script>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
