@model VendorRegistrationForm
@{ ViewData["Title"] = "Đăng ký gian hàng"; }
<div class="login-card" style="width:min(620px,94vw)">
    <div class="login-brand"><span class="brand-icon">B</span><span>Bếp Nhà<small class="muted" style="display:block;font:700 9px 'DM Sans';letter-spacing:1.4px">ĐỐI TÁC / GIAN HÀNG</small></span></div>
    <h1>Đăng ký gian hàng</h1>
    <p>Gửi thông tin để đăng ký trở thành đối tác bán hàng.</p>
    @if (ViewBag.Error is string error) { <div class="alert error">@error</div> }
    <form asp-action="Index" method="post">
        @Html.AntiForgeryToken()
        <div class="form-grid">
            <div class="field"><label>Họ tên chủ gian hàng *</label><input name="OwnerName" value="@Model.OwnerName" required maxlength="100"/></div>
            <div class="field"><label>Tên gian hàng *</label><input name="StoreName" value="@Model.StoreName" required maxlength="120"/></div>
            <div class="field"><label>Email *</label><input name="Email" value="@Model.Email" type="email" required/></div>
            <div class="field"><label>Số điện thoại *</label><input name="Phone" value="@Model.Phone" required maxlength="20"/></div>
            <div class="field" style="grid-column:1/-1"><label>Địa chỉ kinh doanh *</label><input name="Address" value="@Model.Address" required maxlength="250"/></div>
            <div class="field" style="grid-column:1/-1"><label>Loại hình kinh doanh *</label><input name="BusinessType" value="@Model.BusinessType" placeholder="Ví dụ: Cơm, bún, đồ uống..." required maxlength="100"/></div>
        </div>
        <button class="btn btn-primary" type="submit">Gửi hồ sơ đăng ký →</button>
    </form>
    <div style="margin-top:16px"><a asp-controller="Account" asp-action="Login" class="text-link">← Quay lại đăng nhập</a></div>
</div>
