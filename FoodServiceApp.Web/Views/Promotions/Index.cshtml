@model PromotionsViewModel
@{ ViewData["Title"] = "Khuyến mãi"; }
<div class="page-heading"><div><h1>Khuyến mãi & voucher</h1><p>Tạo mã giảm giá, đặt thời gian và điều kiện áp dụng.</p></div><a class="btn btn-primary" href="#promotion-form">＋ Tạo khuyến mãi</a></div>
<div class="card">
    @if(Model.Promotions.Count == 0){<div class="empty">Chưa có chương trình khuyến mãi.</div>}
    else {<div class="table-wrap"><table><thead><tr><th>CHƯƠNG TRÌNH</th><th>MÃ</th><th>ƯU ĐÃI</th><th>ĐIỀU KIỆN</th><th>THỜI GIAN</th><th>TRẠNG THÁI</th><th></th></tr></thead><tbody>
    @foreach(var p in Model.Promotions){
        var food = Model.Foods.FirstOrDefault(f=>f.Id==p.FoodId);
        <tr><td><b>@p.Name</b><div class="food-desc">@(food is null ? "Toàn gian hàng" : $"Món: {food.Name}")</div></td><td><span class="order-id">@p.Code</span></td><td><b>@(p.Type == PromotionType.PhanTram ? $"{p.Value:N0}%" : $"{p.Value:N0} đ")</b>@if(p.MaximumDiscount is > 0){<div class="food-desc">Tối đa @p.MaximumDiscount.Value.ToString("N0") đ</div>}</td><td>Đơn từ @p.MinimumOrder.ToString("N0") đ</td><td>@p.StartAt.ToString("dd/MM/yyyy")<br/>→ @p.EndAt.ToString("dd/MM/yyyy")</td><td><span class="pill @(p.IsActive ? "" : "red")">@(p.IsActive ? "Đang chạy" : "Đã ngừng")</span></td><td><div class="actions"><a class="tiny-button" asp-action="Index" asp-route-edit="@p.Id">Sửa</a><form asp-action="Toggle" method="post">@Html.AntiForgeryToken()<input type="hidden" name="id" value="@p.Id"/><button class="tiny-button" type="submit">@(p.IsActive ? "Ngừng" : "Bật")</button></form></div></td></tr>
    }</tbody></table></div>}
</div>
<div class="card" id="promotion-form" style="margin-top:17px">
<div class="section-head"><h2 class="section-title">@(string.IsNullOrEmpty(Model.Form.Id) ? "Tạo chương trình" : "Cập nhật chương trình")</h2>@if(!string.IsNullOrEmpty(Model.Form.Id)){<a class="text-link" asp-action="Index">＋ Tạo mới</a>}</div>
<form asp-action="Save" method="post">@Html.AntiForgeryToken()<input type="hidden" name="Id" value="@Model.Form.Id"/>
<div class="form-grid">
<div class="field"><label>Tên chương trình *</label><input name="Name" value="@Model.Form.Name" required maxlength="100"/></div>
<div class="field"><label>Mã voucher *</label><input name="Code" value="@Model.Form.Code" required maxlength="30" placeholder="VD: GIAM20"/></div>
<div class="field"><label>Loại giảm</label><select name="Type">@foreach(PromotionType type in Enum.GetValues<PromotionType>()){<option value="@type" selected="@(type==Model.Form.Type)">@(type==PromotionType.PhanTram ? "Phần trăm (%)" : "Số tiền (đ)")</option>}</select></div>
<div class="field"><label>Giá trị giảm *</label><input name="Value" type="number" min="1" value="@(Model.Form.Value == 0 ? "" : Model.Form.Value)" required/></div>
<div class="field"><label>Đơn tối thiểu</label><input name="MinimumOrder" type="number" min="0" value="@Model.Form.MinimumOrder"/></div>
<div class="field"><label>Giảm tối đa</label><input name="MaximumDiscount" type="number" min="0" value="@Model.Form.MaximumDiscount"/></div>
<div class="field"><label>Bắt đầu</label><input name="StartAt" type="date" value="@Model.Form.StartAt.ToString("yyyy-MM-dd")" required/></div>
<div class="field"><label>Kết thúc</label><input name="EndAt" type="date" value="@Model.Form.EndAt.ToString("yyyy-MM-dd")" required/></div>
<div class="field" style="grid-column:1/-1"><label>Phạm vi áp dụng</label><select name="FoodId"><option value="">Toàn gian hàng</option>@foreach(var f in Model.Foods){<option value="@f.Id" selected="@(f.Id==Model.Form.FoodId)">@f.Name</option>}</select></div>
</div><div class="form-actions"><button class="btn btn-primary" type="submit">Lưu chương trình</button></div></form></div>
