@{ ViewData["Title"] = "Đăng nhập"; }
<div class="login-card">
    <div class="login-brand"><span class="brand-icon">B</span><span>Bếp Nhà<small class="muted" style="display:block;font:700 9px 'DM Sans';letter-spacing:1.4px">PORTAL GIAN HÀNG</small></span></div>
    <h1>Chào mừng trở lại</h1><p>Đăng nhập để quản lý gian hàng của bạn.</p>
    @if (ViewBag.Error is string error) { <div class="alert error">@error</div> }
    <form asp-action="Login" method="post">
        @Html.AntiForgeryToken()
        <input type="hidden" name="returnUrl" value="@ViewBag.ReturnUrl" />
        <div class="field"><label for="email">Email</label><input id="email" name="email" type="email" autocomplete="username" placeholder="ban@gianhang.vn" required /></div>
        <div class="field"><label for="password">Mật khẩu</label><input id="password" name="password" type="password" autocomplete="current-password" placeholder="Nhập mật khẩu" required /></div>
        <button class="btn btn-primary" type="submit">Đăng nhập <span>→</span></button>
    </form>
    <div class="demo-note"><b>Tài khoản demo</b><br />comtam.saigon@gianhang.vn<br />Mật khẩu: 123456</div>
    <div style="margin-top:14px;text-align:center">Chưa có gian hàng? <a asp-controller="Registration" asp-action="Index" class="text-link">Đăng ký gian hàng</a></div>
</div>
