@model IReadOnlyList<StoreOrder>
@{ ViewData["Title"] = "Đơn hàng"; var selected = (OrderStatus?)ViewBag.Status; }
<div class="page-heading"><div><h1>Danh sách đơn hàng</h1><p>Tiếp nhận, xác nhận/từ chối, chuẩn bị và bàn giao đơn cho tài xế.</p></div></div>
<div class="card">
<div class="filters"><a class="filter @(selected is null ? "selected" : "")" asp-action="Index">Tất cả</a>@foreach(OrderStatus status in ViewBag.Statuses){<a class="filter @(selected == status ? "selected" : "")" asp-action="Index" asp-route-status="@status">@Label(status)</a>}</div>
@if(Model.Count == 0){<div class="empty">Không có đơn hàng phù hợp.</div>}
else {<div class="table-wrap"><table><thead><tr><th>ĐƠN</th><th>KHÁCH HÀNG</th><th>MÓN</th><th>TỔNG TIỀN</th><th>TRẠNG THÁI</th><th>THAO TÁC</th></tr></thead><tbody>
@foreach(var order in Model){<tr><td><span class="order-id">#@order.Id</span><div class="food-desc">@order.CreatedAt.ToString("dd/MM HH:mm")</div></td><td><b>@order.Customer</b><div class="food-desc">@order.Address</div></td><td>@order.Items</td><td><b>@order.Total.ToString("N0") đ</b></td><td><span class="pill @Css(order.Status)">@Label(order.Status)</span></td><td><div class="actions">
@foreach(var next in Next(order.Status)){<form asp-action="UpdateStatus" method="post">@Html.AntiForgeryToken()<input type="hidden" name="id" value="@order.Id"/><input type="hidden" name="status" value="@next"/><button class="tiny-button @(next is OrderStatus.DaTuChoi ? "danger-text" : "")" type="submit">@ActionLabel(next)</button></form>}
</div></td></tr>}
</tbody></table></div>}
</div>
@functions {
string Label(OrderStatus s)=>s switch{OrderStatus.ChoXacNhan=>"Chờ xác nhận",OrderStatus.DaXacNhan=>"Đã xác nhận",OrderStatus.DangChuanBi=>"Đang chuẩn bị",OrderStatus.SanSangGiao=>"Sẵn sàng giao",OrderStatus.DaBanGiaoTaiXe=>"Đã bàn giao tài xế",OrderStatus.DangGiao=>"Đang giao",OrderStatus.HoanThanh=>"Hoàn thành",OrderStatus.DaTuChoi=>"Đã từ chối",_=>"Đã hủy"};
string Css(OrderStatus s)=>s switch{OrderStatus.ChoXacNhan=>"orange",OrderStatus.DaTuChoi or OrderStatus.DaHuy=>"red",_=>""};
IEnumerable<OrderStatus> Next(OrderStatus s)=>s switch{OrderStatus.ChoXacNhan=>new[]{OrderStatus.DaXacNhan,OrderStatus.DaTuChoi},OrderStatus.DaXacNhan=>new[]{OrderStatus.DangChuanBi},OrderStatus.DangChuanBi=>new[]{OrderStatus.SanSangGiao},OrderStatus.SanSangGiao=>new[]{OrderStatus.DaBanGiaoTaiXe},OrderStatus.DaBanGiaoTaiXe=>new[]{OrderStatus.DangGiao},OrderStatus.DangGiao=>new[]{OrderStatus.HoanThanh},_=>Array.Empty<OrderStatus>()};
string ActionLabel(OrderStatus s)=>s switch{OrderStatus.DaXacNhan=>"Xác nhận",OrderStatus.DaTuChoi=>"Từ chối",OrderStatus.DangChuanBi=>"Chuẩn bị",OrderStatus.SanSangGiao=>"Sẵn sàng",OrderStatus.DaBanGiaoTaiXe=>"Bàn giao tài xế",OrderStatus.DangGiao=>"Tài xế đã nhận",OrderStatus.HoanThanh=>"Hoàn thành",_=>"Cập nhật"};
}
