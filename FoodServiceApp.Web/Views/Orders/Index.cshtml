@model IReadOnlyList<StoreOrder>
@{ ViewData["Title"] = "Đơn hàng"; var selected = (OrderStatus?)ViewBag.Status; }
<div class="page-heading"><div><h1>Danh sách đơn hàng</h1><p>Theo dõi đơn mới và cập nhật tiến độ phục vụ.</p></div></div>
<div class="card">
    <div class="filters"><a class="filter @(selected is null ? "selected" : "")" asp-action="Index">Tất cả</a>@foreach(OrderStatus status in ViewBag.Statuses){<a class="filter @(selected == status ? "selected" : "")" asp-action="Index" asp-route-status="@status">@StatusLabel(status)</a>}</div>
    @if(Model.Count == 0){<div class="empty">Không có đơn hàng phù hợp.</div>}
    else {<div class="table-wrap"><table><thead><tr><th>ĐƠN HÀNG</th><th>KHÁCH HÀNG / ĐỊA CHỈ</th><th>MÓN</th><th>THỜI GIAN</th><th>TỔNG TIỀN</th><th>TRẠNG THÁI</th><th>CẬP NHẬT</th></tr></thead><tbody>
        @foreach(var order in Model){<tr><td><span class="order-id">#@order.Id</span></td><td><b>@order.Customer</b><div class="food-desc">@order.Address</div></td><td>@order.Items</td><td>@order.CreatedAt.ToString("dd/MM HH:mm")</td><td><b>@order.Total.ToString("N0") đ</b></td><td><span class="pill @StatusClass(order.Status)">@StatusLabel(order.Status)</span></td><td><form asp-action="UpdateStatus" method="post" class="status-form">@Html.AntiForgeryToken()<input type="hidden" name="id" value="@order.Id"/><select name="status" class="status-select">@foreach(OrderStatus status in ViewBag.Statuses){<option value="@status" selected="@(order.Status == status)">@StatusLabel(status)</option>}</select><button class="tiny-button" type="submit">Lưu</button></form></td></tr>}
    </tbody></table></div>}
</div>
@functions {
    string StatusLabel(OrderStatus s) => s switch { OrderStatus.ChoXacNhan => "Chờ xác nhận", OrderStatus.DangChuanBi => "Đang chuẩn bị", OrderStatus.DangGiao => "Đang giao", OrderStatus.HoanThanh => "Hoàn thành", _ => "Đã hủy" };
    string StatusClass(OrderStatus s) => s switch { OrderStatus.ChoXacNhan => "orange", OrderStatus.DaHuy => "red", _ => "" };
}
