@model DashboardViewModel
@{ ViewData["Title"] = "Tổng quan"; }
<div class="page-heading"><div><h1>Xin chào, @Model.Store.Name 👋</h1><p>Đây là tình hình hoạt động gian hàng hôm nay.</p></div><a class="btn btn-primary" asp-controller="Catalog" asp-action="Index">＋ Quản lý thực đơn</a></div>
<div class="stats">
    <div class="card"><span class="stat-icon">▤</span><div class="stat-label">Đơn chờ xác nhận</div><div class="stat-value">@Model.PendingCount</div><div class="stat-foot">Cần xử lý sớm</div></div>
    <div class="card"><span class="stat-icon">₫</span><div class="stat-label">Doanh thu hôm nay</div><div class="stat-value">@Model.TodayRevenue.ToString("N0") đ</div><div class="stat-foot">Từ đơn hoàn thành</div></div>
    <div class="card"><span class="stat-icon">✓</span><div class="stat-label">Đơn hoàn thành hôm nay</div><div class="stat-value">@Model.TodayCompleted</div><div class="stat-foot">Đơn đã giao thành công</div></div>
    <div class="card"><span class="stat-icon">🍲</span><div class="stat-label">Món trong thực đơn</div><div class="stat-value">@Model.FoodCount</div><div class="stat-foot">Đang được quản lý</div></div>
</div>
<div class="grid-2">
    <div class="card"><div class="section-head"><h2 class="section-title">Đơn hàng gần đây</h2><a class="text-link" asp-controller="Orders" asp-action="Index">Xem tất cả →</a></div>
        @if (Model.RecentOrders.Count == 0) { <div class="empty">Chưa có đơn hàng.</div> }
        else { <div class="table-wrap"><table><thead><tr><th>MÃ ĐƠN</th><th>KHÁCH HÀNG</th><th>TỔNG TIỀN</th><th>TRẠNG THÁI</th></tr></thead><tbody>
        @foreach (var order in Model.RecentOrders) { <tr><td><a class="order-id" asp-controller="Orders" asp-action="Index">#@order.Id</a></td><td>@order.Customer</td><td><b>@order.Total.ToString("N0") đ</b></td><td><span class="pill @(order.Status == OrderStatus.ChoXacNhan ? "orange" : "")">@StatusLabel(order.Status)</span></td></tr> }
        </tbody></table></div> }
    </div>
    <div class="card"><div class="section-head"><h2 class="section-title">Thông tin gian hàng</h2><a class="text-link" asp-controller="Store" asp-action="Profile">Chỉnh sửa →</a></div>
        <div class="store-banner"><div class="store-emoji">🍚</div><div><h3>@Model.Store.Name</h3><p>@Model.Store.Address</p></div></div>
        <div style="display:flex;gap:8px;margin-top:18px;align-items:center"><span class="pill @(Model.Store.IsOpen ? "" : "red")">@(Model.Store.IsOpen ? "Đang mở bán" : "Đang tạm đóng")</span><span class="muted">Giao dự kiến @Model.Store.DeliveryMinutes phút</span></div>
        <div style="border-top:1px solid var(--line);margin-top:17px;padding-top:14px;color:var(--muted);line-height:1.9">☎ @Model.Store.Phone<br />✉ @Model.Store.Email</div>
    </div>
</div>
@functions { string StatusLabel(OrderStatus s) => s switch { OrderStatus.ChoXacNhan => "Chờ xác nhận", OrderStatus.DangChuanBi => "Đang chuẩn bị", OrderStatus.DangGiao => "Đang giao", OrderStatus.HoanThanh => "Hoàn thành", _ => "Đã hủy" }; }
