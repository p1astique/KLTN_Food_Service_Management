<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:services="clr-namespace:FoodServiceApp.Maui.Services"
             x:Class="FoodServiceApp.Maui.Views.AdminVendorListPage"
             Title="Danh sách gian hàng">

    <RefreshView x:Name="RefreshDsGianHang" Refreshing="OnRefreshing">
        <ScrollView>
            <VerticalStackLayout Padding="16" Spacing="10">

                <CollectionView x:Name="DsGianHang" SelectionMode="None">
                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="services:VendorRegistrationDto">
                            <Frame Style="{StaticResource CardFrame}" Margin="0,0,0,10">
                                <VerticalStackLayout Spacing="6">
                                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
                                        <Label Grid.Column="0" Text="🍽️" FontSize="28" />
                                        <VerticalStackLayout Grid.Column="1">
                                            <Label Text="{Binding StoreName}" FontAttributes="Bold" FontSize="14" />
                                            <Label FontSize="11" TextColor="{StaticResource TextGrey}"
                                                   Text="{Binding CreatedAt, StringFormat='Tham gia từ {0:dd/MM/yyyy}'}" />
                                        </VerticalStackLayout>
                                    </Grid>
                                 
                                </VerticalStackLayout>
                            </Frame>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>

            </VerticalStackLayout>
        </ScrollView>
    </RefreshView>
</ContentPage>
